# BigWigsMods/packager configuration (see .github/workflows/release.yml)
#
# The packager ships every tracked file that is not dot-prefixed, so anything
# added here that is development-only must be listed under "ignore" or it ends
# up inside the released addon zip.

package-as: PickPocketTracker

ignore:
  - tests
  # Project artwork for the CurseForge page, not an addon texture: the WoW
  # client only loads BLP and TGA, so this 1024x1024 PNG cannot be used in
  # game and nothing in the TOC or Lua references it. It was 90% of the
  # download size.
  - assets

# Release notes for CurseForge and the GitHub Release come from this file
# instead of the commit log. Update it in each version-bump commit.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
